@model System_student_record.Models.Course

<!DOCTYPE html>
<html>

<head>

    <title>Edit Course</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body style="background:#f4f6f9;">

    <div class="container mt-5">

        <div class="card shadow p-4">

            <h2 class="mb-4">
                Edit Course
            </h2>

            <form method="post">

                <input type="hidden"
                       asp-for="Id">

                <div class="mb-3">

                    <label>
                        Course Code
                    </label>

                    <input asp-for="CourseCode"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label>
                        Course Name
                    </label>

                    <input asp-for="CourseName"
                           class="form-control">

                </div>

                <button class="btn btn-warning">

                    Update Course

                </button>

            </form>

        </div>

    </div>

</body>

</html>