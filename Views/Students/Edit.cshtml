@model System_student_record.Models.Student

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <title>Edit Student</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body style="background:#f4f6f9;">

    <div class="container mt-5">

        <div class="card shadow p-4">

            <h2 class="mb-4">
                Edit Student
            </h2>

            <form method="post">

                <input type="hidden"
                       asp-for="Id">

                <div class="mb-3">

                    <label>Student ID</label>

                    <input asp-for="StudentId"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label>Name</label>

                    <input asp-for="Name"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label>Age</label>

                    <input asp-for="Age"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label>Grade</label>

                    <input asp-for="Grade"
                           class="form-control">

                </div>

                <button class="btn btn-warning">

                    Update Student

                </button>

                <a href="/Students/Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</body>

</html>