<!DOCTYPE html>
<html>

<head>
    <script>

              history.pushState(null, null, location.href);

            window.onpopstate = function ()
            {
                history.go(1);
            };

    </script>

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>

            body {
                margin: 0;
                background: #f4f6f9;
                font-family: Arial;
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                background: #001f4d;
                position: fixed;
                color: white;
                padding-top: 20px;
            }

                .sidebar h3 {
                    text-align: center;
                    margin-bottom: 30px;
                }

                .sidebar a {
                    display: block;
                    color: white;
                    padding: 15px;
                    text-decoration: none;
                    transition: 0.3s;
                }

                    .sidebar a:hover {
                        background: #0052D4;
                    }

            .main {
                margin-left: 250px;
                padding: 20px;
            }

            .topbar {
                background: linear-gradient(to right,#0052D4,#4364F7);
                color: white;
                padding: 20px;
                border-radius: 10px;
            }

            .cards {
                display: flex;
                gap: 20px;
                margin-top: 20px;
            }

            .card-box {
                flex: 1;
                background: white;
                padding: 20px;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

                .card-box h2 {
                    color: #0052D4;
                }

            .welcome-box {
                background: white;
                margin-top: 20px;
                padding: 20px;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <h3>🎓 Student System</h3>

        <a href="/Students/Dashboard">

            <i class="fa fa-home"></i>
            Dashboard

        </a>

        <a href="/Students/Index">

            <i class="fa fa-users"></i>
            Students

        </a>

        <a href="/Students/Create">

            <i class="fa fa-plus"></i>
            Add Student

        </a>

        <a href="/Account/Logout">

            <i class="fa fa-sign-out-alt"></i>
            Logout

        </a>

    </div>

    <!-- MAIN -->

    <div class="main">

        <!-- TOPBAR -->

        <div class="topbar">

            <h2>Dashboard</h2>

            <p>
                Welcome Back Admin
            </p>

        </div>

        <!-- CARDS -->

        <div class="cards">

            <div class="card-box">

                <h5>Total Students</h5>

                <h2>25</h2>

            </div>

            <div class="card-box">

                <h5>Average Grade</h5>

                <h2>85.60</h2>

            </div>

            <div class="card-box">

                <h5>Active Users</h5>

                <h2>5</h2>

            </div>

        </div>

        <!-- WELCOME -->

        <div class="welcome-box">

            <h3>
                Welcome to Student Record System
            </h3>

            <p>
                Use the sidebar to manage students,
                add records, edit information,
                and monitor student data.
            </p>

        </div>

    </div>

</body>

</html>