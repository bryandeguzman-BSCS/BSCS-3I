@model IEnumerable<System_student_record.Models.Student>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>

    <script>

            history.pushState(null, null, location.href);

            window.onpopstate = function ()
            {
                history.go(1);
            };

    </script>

    <title>Students</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>

            body {
                margin: 0;
                padding: 0;
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                background: #001f4d;
                position: fixed;
                color: white;
                padding-top: 20px;
            }

                .sidebar h3 {
                    text-align: center;
                    margin-bottom: 30px;
                }

                .sidebar a {
                    display: block;
                    color: white;
                    padding: 15px;
                    text-decoration: none;
                    transition: 0.3s;
                }

                    .sidebar a:hover {
                        background: #0052D4;
                    }

            .main {
                margin-left: 250px;
                padding: 20px;
                min-height: 100vh;
            }

            .table-box {
                background: white;
                padding: 20px;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

            .table th {
                background: #0052D4;
                color: white;
            }

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .search-box {
                width: 250px;
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <h3>🎓 Student System</h3>

        <a href="/Students/Dashboard">

            <i class="fa fa-home"></i>
            Dashboard

        </a>

        <a href="/Students/Index">

            <i class="fa fa-users"></i>
            Students

        </a>

        <a href="/Students/Create">

            <i class="fa fa-plus"></i>
            Add Student

        </a>

        <a href="/Courses/Index">

            <i class="fa fa-book"></i>
            Courses

        </a>

        <a href="/Account/Logout">

            <i class="fa fa-sign-out-alt"></i>
            Logout

        </a>

    </div>

    <!-- MAIN -->

    <div class="main">

        <div class="table-box">

            <div class="top-bar">

                <h2>
                    Student List
                </h2>

                <div>

                    <a href="/Students/Create"
                       class="btn btn-primary">

                        <i class="fa fa-plus"></i>
                        Add Student

                    </a>

                </div>

            </div>

            <!-- SEARCH -->

            <div class="search-box mb-3">

                <input type="text"
                       class="form-control"
                       placeholder="Search student...">

            </div>

            <!-- TABLE -->

            <table class="table table-hover table-bordered">

                <thead>

                    <tr>

                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Grade</th>
                        <th width="150">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.StudentId</td>

                            <td>@item.Name</td>

                            <td>@item.Age</td>

                            <td>

                                <span class="badge bg-success">

                                    @item.Grade

                                </span>

                            </td>

                            <td>

                                <!-- EDIT -->

                                <a href="/Students/Edit/@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fa fa-edit"></i>

                                </a>

                                <!-- DELETE -->

                                <a asp-controller="Students"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this student?')">

                                    <i class="fa fa-trash"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</body>

</html>